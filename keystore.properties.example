# Release signing configuration (optional).
# Copy this file to `keystore.properties` (git-ignored) and fill in real values
# to sign release builds with your own keystore. Without this file, the release
# build falls back to the debug signing config.
storeFile=/absolute/path/to/your-release.jks
storePassword=changeit
keyAlias=pyxissapiens
keyPassword=changeit
